{
  "name": "passage-cdc-${DOMAIN}",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.hostname": "${DOMAIN_DB_HOST}",
    "database.port": "5432",
    "database.user": "${CDC_DB_USER}",
    "database.password": "${file:/vault/cdc/credentials.properties:password}",
    "database.dbname": "passage_${DOMAIN}",
    "topic.prefix": "cdc.${DOMAIN}",
    "schema.include.list": "public",
    "table.include.list": "${TABLE_INCLUDE_LIST}",
    "slot.name": "passage_cdc_${DOMAIN}",
    "publication.name": "passage_cdc_${DOMAIN}",
    "publication.autocreate.mode": "filtered",
    "snapshot.mode": "initial",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "insert into analytics_heartbeat (id, ts) values (1, now()) on conflict (id) do update set ts = excluded.ts",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "${SCHEMA_REGISTRY_URL}",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "${SCHEMA_REGISTRY_URL}",
    "tombstones.on.delete": "true",
    "decimal.handling.mode": "string",
    "time.precision.mode": "adaptive_time_microseconds",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.add.fields": "op,lsn,source.ts_ms",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "key.converter.auto.register.schemas": "true",
    "value.converter.auto.register.schemas": "true",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "cdc\\.([^.]+)\\.public\\.([^.]+)",
    "transforms.route.replacement": "cdc.$1.$2"
  }
}
