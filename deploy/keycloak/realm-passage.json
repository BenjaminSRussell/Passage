  "users": [
    {
      "username": "service-account-passage-identity-deprovision",
      "enabled": true,
      "serviceAccountClientId": "passage-identity-deprovision",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "passage-identity-deprovision",
        "roles": [
          "manage-users"
        ]
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "corporate-oidc",
      "displayName": "Corporate OIDC",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "authorizationUrl": "https://idp.example.invalid/authorize",
        "tokenUrl": "https://idp.example.invalid/token",
        "jwksUrl": "https://idp.example.invalid/jwks",
        "issuer": "https://idp.example.invalid",
        "clientId": "REPLACE_WITH_CLIENT_ID",
        "clientAuthMethod": "client_secret_post",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "defaultScope": "openid email profile"
      },
      "postBrokerLoginFlowAlias": "passage-post-broker-mfa"
    },
    {
      "alias": "corporate-saml",
      "displayName": "Corporate SAML",
      "providerId": "saml",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "linkOnly": false,
      "config": {
        "singleSignOnServiceUrl": "https://idp.example.invalid/saml/sso",
        "entityId": "https://auth.passage.example.invalid/realms/passage",
        "idpEntityId": "https://idp.example.invalid/saml",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:1.1:nameid-format:persistent",
        "wantAssertionsSigned": "true",
        "validateSignature": "true",
        "postBindingResponse": "true"
      },
      "postBrokerLoginFlowAlias": "passage-post-broker-mfa"
    }
  ],
  "identityProviderMappers": [
    {
      "name": "tenant",
      "identityProviderAlias": "corporate-oidc",
