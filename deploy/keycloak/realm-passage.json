  "authenticationFlows": [
    {
      "alias": "passage-browser-mfa",
      "description": "Browser login that requires a second factor (OTP or WebAuthn)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "passage-browser-mfa forms"
        }
      ]
    },
    {
      "alias": "passage-browser-mfa forms",
      "description": "Password then second factor",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "passage-browser-mfa second factor"
        }
      ]
    },
    {
      "alias": "passage-browser-mfa second factor",
      "description": "WebAuthn or OTP, whichever the user has; a user with neither enrols OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "webauthn-authenticator"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "passage-browser-mfa otp"
        }
      ]
    },
    {
      "alias": "passage-browser-mfa otp",
      "description": "OTP form; sends a user without OTP to CONFIGURE_TOTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "passage-post-broker-mfa",
      "description": "Second factor after federated login",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "passage-post-broker-mfa second factor"
        }
      ]
    },
    {
      "alias": "passage-post-broker-mfa second factor",
      "description": "WebAuthn or OTP, whichever the user has; a user with neither enrols OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "webauthn-authenticator"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "passage-post-broker-mfa otp"
        }
      ]
    },
    {
      "alias": "passage-post-broker-mfa otp",
      "description": "OTP form; sends a user without OTP to CONFIGURE_TOTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
