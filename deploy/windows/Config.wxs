<?xml version="1.0" encoding="utf-8"?>
<!-- One Property + RegistrySearch + SetProperty + Registry value per MSI property, so a value given once survives upgrade and repair.
     Names must stay equal to tools/passage-server/policy_windows.go registryValueNames (SERVICE_ACCOUNT, LISTEN_PORT, OPEN_FIREWALL are read by the MSI only). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- Postgres owner URL (creates and migrates the service databases). Secret. -->
    <Property Id="PG_DSN" Secure="yes" Hidden="yes" />
    <Property Id="PREV_PG_DSN" Secure="yes" Hidden="yes">
      <RegistrySearch Id="Search_PG_DSN" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="PG_DSN" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="PG_DSN" Value="[PREV_PG_DSN]" After="AppSearch" Condition="NOT PG_DSN AND PREV_PG_DSN" />
    <!-- passage_app URL every service connects as (NOBYPASSRLS). Secret. -->
    <Property Id="PG_APP_DSN" Secure="yes" Hidden="yes" />
    <Property Id="PREV_PG_APP_DSN" Secure="yes" Hidden="yes">
      <RegistrySearch Id="Search_PG_APP_DSN" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="PG_APP_DSN" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="PG_APP_DSN" Value="[PREV_PG_APP_DSN]" After="AppSearch" Condition="NOT PG_APP_DSN AND PREV_PG_APP_DSN" />
    <!-- OIDC issuer URL (Keycloak realm). -->
    <Property Id="OIDC_ISSUER" Secure="yes" />
    <Property Id="PREV_OIDC_ISSUER" Secure="yes">
      <RegistrySearch Id="Search_OIDC_ISSUER" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_ISSUER" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="OIDC_ISSUER" Value="[PREV_OIDC_ISSUER]" After="AppSearch" Condition="NOT OIDC_ISSUER AND PREV_OIDC_ISSUER" />
    <!-- Token audience, default passage-api. -->
    <Property Id="OIDC_AUDIENCE" Secure="yes" />
    <Property Id="PREV_OIDC_AUDIENCE" Secure="yes">
      <RegistrySearch Id="Search_OIDC_AUDIENCE" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_AUDIENCE" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="OIDC_AUDIENCE" Value="[PREV_OIDC_AUDIENCE]" After="AppSearch" Condition="NOT OIDC_AUDIENCE AND PREV_OIDC_AUDIENCE" />
    <!-- JWKS URL when it is not the issuer's default. -->
    <Property Id="OIDC_JWKS_URL" Secure="yes" />
    <Property Id="PREV_OIDC_JWKS_URL" Secure="yes">
      <RegistrySearch Id="Search_OIDC_JWKS_URL" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_JWKS_URL" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="OIDC_JWKS_URL" Value="[PREV_OIDC_JWKS_URL]" After="AppSearch" Condition="NOT OIDC_JWKS_URL AND PREV_OIDC_JWKS_URL" />
    <!-- Tenant id the gateway accepts. -->
    <Property Id="TENANT_ID" Secure="yes" />
    <Property Id="PREV_TENANT_ID" Secure="yes">
      <RegistrySearch Id="Search_TENANT_ID" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TENANT_ID" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="TENANT_ID" Value="[PREV_TENANT_ID]" After="AppSearch" Condition="NOT TENANT_ID AND PREV_TENANT_ID" />
    <!-- Base URL of the OPA server. -->
    <Property Id="OPA_URL" Secure="yes" />
    <Property Id="PREV_OPA_URL" Secure="yes">
      <RegistrySearch Id="Search_OPA_URL" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OPA_URL" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="OPA_URL" Value="[PREV_OPA_URL]" After="AppSearch" Condition="NOT OPA_URL AND PREV_OPA_URL" />
    <!-- Comma-separated Kafka bootstrap servers (passed to services as KAFKA_BROKERS). -->
    <Property Id="KAFKA_BOOTSTRAP" Secure="yes" />
    <Property Id="PREV_KAFKA_BOOTSTRAP" Secure="yes">
      <RegistrySearch Id="Search_KAFKA_BOOTSTRAP" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="KAFKA_BOOTSTRAP" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="KAFKA_BOOTSTRAP" Value="[PREV_KAFKA_BOOTSTRAP]" After="AppSearch" Condition="NOT KAFKA_BOOTSTRAP AND PREV_KAFKA_BOOTSTRAP" />
    <!-- Temporal frontend host:port (passed to services as TEMPORAL_ADDRESS). -->
    <Property Id="TEMPORAL_HOSTPORT" Secure="yes" />
    <Property Id="PREV_TEMPORAL_HOSTPORT" Secure="yes">
      <RegistrySearch Id="Search_TEMPORAL_HOSTPORT" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TEMPORAL_HOSTPORT" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="TEMPORAL_HOSTPORT" Value="[PREV_TEMPORAL_HOSTPORT]" After="AppSearch" Condition="NOT TEMPORAL_HOSTPORT AND PREV_TEMPORAL_HOSTPORT" />
    <!-- Gateway listen address, default 127.0.0.1:8443. -->
    <Property Id="LISTEN" Secure="yes" />
    <Property Id="PREV_LISTEN" Secure="yes">
      <RegistrySearch Id="Search_LISTEN" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="LISTEN" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="LISTEN" Value="[PREV_LISTEN]" After="AppSearch" Condition="NOT LISTEN AND PREV_LISTEN" />
    <!-- PASSAGE_CLOUD_PROFILE, for example commercial or gcc. -->
    <Property Id="CLOUD_PROFILE" Secure="yes" />
    <Property Id="PREV_CLOUD_PROFILE" Secure="yes">
      <RegistrySearch Id="Search_CLOUD_PROFILE" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="CLOUD_PROFILE" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="CLOUD_PROFILE" Value="[PREV_CLOUD_PROFILE]" After="AppSearch" Condition="NOT CLOUD_PROFILE AND PREV_CLOUD_PROFILE" />
    <!-- PEM certificate path. -->
    <Property Id="TLS_CERT_FILE" Secure="yes" />
    <Property Id="PREV_TLS_CERT_FILE" Secure="yes">
      <RegistrySearch Id="Search_TLS_CERT_FILE" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TLS_CERT_FILE" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="TLS_CERT_FILE" Value="[PREV_TLS_CERT_FILE]" After="AppSearch" Condition="NOT TLS_CERT_FILE AND PREV_TLS_CERT_FILE" />
    <!-- PEM private key path. -->
    <Property Id="TLS_KEY_FILE" Secure="yes" />
    <Property Id="PREV_TLS_KEY_FILE" Secure="yes">
      <RegistrySearch Id="Search_TLS_KEY_FILE" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TLS_KEY_FILE" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="TLS_KEY_FILE" Value="[PREV_TLS_KEY_FILE]" After="AppSearch" Condition="NOT TLS_KEY_FILE AND PREV_TLS_KEY_FILE" />
    <!-- 1 makes the server refuse to start without FIPS mode. -->
    <Property Id="REQUIRE_FIPS" Secure="yes" />
    <Property Id="PREV_REQUIRE_FIPS" Secure="yes">
      <RegistrySearch Id="Search_REQUIRE_FIPS" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="REQUIRE_FIPS" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="REQUIRE_FIPS" Value="[PREV_REQUIRE_FIPS]" After="AppSearch" Condition="NOT REQUIRE_FIPS AND PREV_REQUIRE_FIPS" />
    <!-- 1 lets a non-loopback LISTEN serve plain HTTP (behind a TLS-terminating proxy). -->
    <Property Id="ALLOW_PLAINTEXT" Secure="yes" />
    <Property Id="PREV_ALLOW_PLAINTEXT" Secure="yes">
      <RegistrySearch Id="Search_ALLOW_PLAINTEXT" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="ALLOW_PLAINTEXT" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="ALLOW_PLAINTEXT" Value="[PREV_ALLOW_PLAINTEXT]" After="AppSearch" Condition="NOT ALLOW_PLAINTEXT AND PREV_ALLOW_PLAINTEXT" />
    <!-- Service account: virtual NT SERVICE\Passage by default, or DOMAIN\gmsa$. -->
    <Property Id="SERVICE_ACCOUNT" Secure="yes" />
    <Property Id="PREV_SERVICE_ACCOUNT" Secure="yes">
      <RegistrySearch Id="Search_SERVICE_ACCOUNT" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="SERVICE_ACCOUNT" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="SERVICE_ACCOUNT" Value="[PREV_SERVICE_ACCOUNT]" After="AppSearch" Condition="NOT SERVICE_ACCOUNT AND PREV_SERVICE_ACCOUNT" />
    <SetProperty Id="SERVICE_ACCOUNT" Action="Default_SERVICE_ACCOUNT" Value="NT SERVICE\Passage" After="Set_SERVICE_ACCOUNT" Condition="NOT SERVICE_ACCOUNT" />
    <!-- Port of the firewall rule; keep equal to the port in LISTEN. -->
    <Property Id="LISTEN_PORT" Secure="yes" />
    <Property Id="PREV_LISTEN_PORT" Secure="yes">
      <RegistrySearch Id="Search_LISTEN_PORT" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="LISTEN_PORT" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="LISTEN_PORT" Value="[PREV_LISTEN_PORT]" After="AppSearch" Condition="NOT LISTEN_PORT AND PREV_LISTEN_PORT" />
    <SetProperty Id="LISTEN_PORT" Action="Default_LISTEN_PORT" Value="8443" After="Set_LISTEN_PORT" Condition="NOT LISTEN_PORT" />
    <!-- 1 opens the inbound rule for a non-loopback LISTEN. -->
    <Property Id="OPEN_FIREWALL" Secure="yes" />
    <Property Id="PREV_OPEN_FIREWALL" Secure="yes">
      <RegistrySearch Id="Search_OPEN_FIREWALL" Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OPEN_FIREWALL" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="OPEN_FIREWALL" Value="[PREV_OPEN_FIREWALL]" After="AppSearch" Condition="NOT OPEN_FIREWALL AND PREV_OPEN_FIREWALL" />
    <SetProperty Id="OPEN_FIREWALL" Action="Default_OPEN_FIREWALL" Value="1" After="Set_OPEN_FIREWALL" Condition="NOT OPEN_FIREWALL" />
  </Fragment>
  <Fragment>
    <ComponentGroup Id="ConfigRegistry" Directory="INSTALLFOLDER">
      <Component Id="Cfg_PG_DSN" Guid="*" Bitness="always64" Condition="PG_DSN">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="PG_DSN" Type="string" Value="[PG_DSN]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_PG_APP_DSN" Guid="*" Bitness="always64" Condition="PG_APP_DSN">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="PG_APP_DSN" Type="string" Value="[PG_APP_DSN]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_OIDC_ISSUER" Guid="*" Bitness="always64" Condition="OIDC_ISSUER">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_ISSUER" Type="string" Value="[OIDC_ISSUER]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_OIDC_AUDIENCE" Guid="*" Bitness="always64" Condition="OIDC_AUDIENCE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_AUDIENCE" Type="string" Value="[OIDC_AUDIENCE]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_OIDC_JWKS_URL" Guid="*" Bitness="always64" Condition="OIDC_JWKS_URL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OIDC_JWKS_URL" Type="string" Value="[OIDC_JWKS_URL]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_TENANT_ID" Guid="*" Bitness="always64" Condition="TENANT_ID">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TENANT_ID" Type="string" Value="[TENANT_ID]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_OPA_URL" Guid="*" Bitness="always64" Condition="OPA_URL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OPA_URL" Type="string" Value="[OPA_URL]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_KAFKA_BOOTSTRAP" Guid="*" Bitness="always64" Condition="KAFKA_BOOTSTRAP">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="KAFKA_BOOTSTRAP" Type="string" Value="[KAFKA_BOOTSTRAP]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_TEMPORAL_HOSTPORT" Guid="*" Bitness="always64" Condition="TEMPORAL_HOSTPORT">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TEMPORAL_HOSTPORT" Type="string" Value="[TEMPORAL_HOSTPORT]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_LISTEN" Guid="*" Bitness="always64" Condition="LISTEN">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="LISTEN" Type="string" Value="[LISTEN]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_CLOUD_PROFILE" Guid="*" Bitness="always64" Condition="CLOUD_PROFILE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="CLOUD_PROFILE" Type="string" Value="[CLOUD_PROFILE]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_TLS_CERT_FILE" Guid="*" Bitness="always64" Condition="TLS_CERT_FILE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TLS_CERT_FILE" Type="string" Value="[TLS_CERT_FILE]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_TLS_KEY_FILE" Guid="*" Bitness="always64" Condition="TLS_KEY_FILE">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="TLS_KEY_FILE" Type="string" Value="[TLS_KEY_FILE]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_REQUIRE_FIPS" Guid="*" Bitness="always64" Condition="REQUIRE_FIPS">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="REQUIRE_FIPS" Type="string" Value="[REQUIRE_FIPS]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_ALLOW_PLAINTEXT" Guid="*" Bitness="always64" Condition="ALLOW_PLAINTEXT">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="ALLOW_PLAINTEXT" Type="string" Value="[ALLOW_PLAINTEXT]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_SERVICE_ACCOUNT" Guid="*" Bitness="always64" Condition="SERVICE_ACCOUNT">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="SERVICE_ACCOUNT" Type="string" Value="[SERVICE_ACCOUNT]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_LISTEN_PORT" Guid="*" Bitness="always64" Condition="LISTEN_PORT">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="LISTEN_PORT" Type="string" Value="[LISTEN_PORT]" KeyPath="yes" />
      </Component>
      <Component Id="Cfg_OPEN_FIREWALL" Guid="*" Bitness="always64" Condition="OPEN_FIREWALL">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Passage\Config" Name="OPEN_FIREWALL" Type="string" Value="[OPEN_FIREWALL]" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
