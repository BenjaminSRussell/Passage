{
  "name": "@passage/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/worker.js",
    "test": "npm run check:schemas && vitest",
    "check:schemas": "tsx src/checkSchemas.ts schemas/baseline schemas/current",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
