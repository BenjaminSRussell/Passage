      {"resource": "/v1/party/tax-registrations:validate", "methods": ["POST"]},
      {"resource": "/v1/party/parties", "methods": ["POST"]},
      {"resource": "/v1/party/parties/*", "methods": ["PATCH"]},
      {"resource": "/v1/party/customers/*/credit-limit", "methods": ["POST"]}
    ]},
    "party.read": {"permissions": [
      {"resource": "/v1/party/parties/*", "methods": ["GET"]},
      {"resource": "/v1/party/pending-changes/*", "methods": ["GET"]},
      {"resource": "/v1/party/legal-entities/*/protected-fields", "methods": ["GET"]}
    ]},
    "pii.read": {"flag": true, "permissions": []},
    "party.approve": {"permissions": [
      {"resource": "/v1/party/pending-changes/*:approve", "methods": ["POST"]},
      {"resource": "/v1/party/pending-changes/*:reject", "methods": ["POST"]}
    ]},
    "party.approval_policy.write": {"permissions": [
      {"resource": "/v1/party/legal-entities/*/protected-fields", "methods": ["PUT"]}
    ]}
  }
}
